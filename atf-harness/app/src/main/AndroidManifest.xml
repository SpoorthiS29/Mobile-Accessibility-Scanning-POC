<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Single-APK ATF harness. No launcher activity and no instrumentation:
      the scan runs inside AtfAccessibilityService, which the Spring Boot side
      enables over adb once, then triggers with a broadcast to
      ScanCommandReceiver. Appium's UiAutomator2 server keeps running.

      WRITE_SETTINGS is granted over adb
      (appops set com.fireflink.a11y.atf WRITE_SETTINGS allow) and is only
      used by the WCAG 1.3.4 Orientation check to rotate the display.
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false">

        <service
            android:name="com.fireflink.a11y.atf.AtfAccessibilityService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/atf_accessibility_service" />
        </service>

        <!-- DUMP is held by the shell (adb) and the system only. -->
        <receiver
            android:name="com.fireflink.a11y.atf.ScanCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.fireflink.a11y.atf.action.PING" />
                <action android:name="com.fireflink.a11y.atf.action.SCAN" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
